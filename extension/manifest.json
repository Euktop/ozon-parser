{
  "manifest_version": 3,
  "name": "Ozon Parser",
  "version": "0.6.0",
  "description": "Отправляет текущую Ozon PDP в локальный ozon-parser (SQLite + Markdown).",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "storage",
    "notifications",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.ozon.ru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ozon Parser",
    "default_popup": "popup.html"
  },
  "commands": {
    "ingest-active": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Ingest current Ozon PDP into local collection"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "key": ""
}
