# Extension private key (RSA-2048). Нужен только для Chrome Web Store
# upload; в git не кладём — при утере ID будет другим (не восстановить).
# Старый pem в корне (был до build/gen_extension_key.py) — тоже приватный
extension.pem

# Extension package (build artifact, собирается через chrome://extensions → Pack)
extension.crx

# Installer output (build artifact, собирается iscc)
installer/Output/

# Локальные артефакты
out/

